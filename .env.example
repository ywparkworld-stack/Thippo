# 値は書かない。キー名だけを並べる（SPEC §0）。
# 各アプリの .env.local（ローカル）または Vercel の環境変数（staging / production）に設定する。

# --- 環境 ---
# development | staging | production
APP_ENV=

# --- ドメイン（TODO(要確認): 本番のドメイン。SPEC §16） ---
NEXT_PUBLIC_GUEST_URL=
NEXT_PUBLIC_HOST_URL=
# 運営管理の URL は利用者サイト・貸出主センターからリンクしないため、admin アプリだけに設定する
ADMIN_URL=

# --- 運営管理の前段のアクセス制限（admin アプリだけ。docs/admin-access.md） ---
# cloudflare | vercel | none（none は APP_ENV=development のときだけ有効）
ADMIN_ACCESS_GATE=
# Cloudflare Access のチーム ドメイン（例: thippo.cloudflareaccess.com）と Application Audience (AUD) タグ
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。クライアントに渡さない
SUPABASE_SERVICE_ROLE_KEY=

# --- 決済モード（付録 D37） ---
# stripe（既定）：Stripe で決済する / stub：Stripe につながずに支払い・返金・入金先の登録を成功扱いにする（開発・確認用）
# stub は APP_ENV=production では使えない（起動後、決済の処理で例外になる）。stub のときは下の Stripe のキーは不要
PAYMENTS_MODE=

# --- Stripe（development / staging はテストモードのキー） ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- メール（Resend） ---
RESEND_API_KEY=
MAIL_FROM=
# TODO(要確認): お問い合わせ先のメールアドレス（SPEC §16）
CONTACT_EMAIL=
# 運営への通知（掲載申込など）の送り先
ADMIN_NOTIFICATION_EMAIL=

# --- 領収書の発行者（運営。付録 D9・D21） ---
# TODO(要確認): 運営の会社名・住所・適格請求書発行事業者の登録番号（SPEC §16）
OPERATOR_COMPANY_NAME=
OPERATOR_ADDRESS=
OPERATOR_INVOICE_REGISTRATION_NUMBER=

# --- 定期実行 ---
CRON_SECRET=

# --- Sentry（エラー監視。DSN がなければ送らない） ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- テスト（ローカルの DB テスト） ---
# 素の PostgreSQL（shim を使う）: 既定は postgres://postgres@localhost:54329/postgres
TEST_PG_URL=
# supabase start 済みの環境に対して実行する場合
SUPABASE_DB_URL=
