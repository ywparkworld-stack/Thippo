{
  "name": "@thippo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./browser": "./src/browser.ts",
    "./admin": "./src/admin.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "gen:types:pg": "node --experimental-strip-types scripts/gen-types-from-pg.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@thippo/eslint-config": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "pg": "^8.16.3",
    "typescript": "^5.9.3"
  }
}
